#!/bin/bash

# --- Configuration ---
# The remote URL containing the list of valid HWID keys (one per line).
HWID_URL="https://raw.githubusercontent.com/yessirrrrrrrrasdfadfgnkjrwgn/macsploithwid/refs/heads/main/hwid"

# The local file path on the desktop to cache the successful HWID key.
# This file is checked first to allow immediate access on subsequent runs.
CACHE_FILE="${HOME}/Desktop/hwid_key.txt"

# --- Authentication Logic ---

# 1. Check if the local cache file exists and contains a valid key.
if [[ -f "$CACHE_FILE" ]]; then
    # Read the cached key to show what was used for access, but the main point is the file exists.
    CACHED_HWID=$(<"$CACHE_FILE")
    echo "🔑 Cached key found. Access granted immediately."
    echo "good"
    exit 0
fi

# 2. Start the main validation loop. This loop continues until a key is successfully
# validated and cached, or the user chooses not to try again.
while true; do
    # Prompt the user for the key.
    # We force input from the terminal /dev/tty to work correctly when piped (e.g., curl | bash).
    read -r -p "🔑 Please enter a hwid key: " USER_INPUT_KEY < /dev/tty

    if [[ -z "$USER_INPUT_KEY" ]]; then
        echo "❌ Key cannot be empty. Access denied."
        # If the key is empty, immediately ask if they want to retry.
    else
        echo "🔍 Checking key against remote list..."

        # 3. Fetch the content from the remote URL.
        # Pipe through 'tr -d "\r"' to remove Windows carriage returns for clean line matching.
        REMOTE_HWIDS=$(curl --silent --fail --max-time 10 "$HWID_URL" | tr -d '\r')
        CURL_STATUS=$?

        # Check if curl succeeded
        if [[ $CURL_STATUS -ne 0 ]]; then
            echo "❌ Failed to fetch the HWID list from the server. Check your network or the URL."
            # Fall through to the retry prompt if network failure occurs
        else
            # 4. Check if the user's input key matches any line in the remote list.
            echo "$REMOTE_HWIDS" | grep -Fxq "$USER_INPUT_KEY"

            if [[ $? -eq 0 ]]; then
                # Key is correct! Exit successfully.
                echo "✅ Key matched."
                echo "good"

                # 5. Save the valid key to the desktop cache file as requested.
                echo "$USER_INPUT_KEY" > "$CACHE_FILE"
                echo "📝 HWID key saved to: $CACHE_FILE for future use."
                exit 0
            else
                # Key is incorrect.
                echo "❌ Key does not match any entry in the remote list. Access denied."
                # Fall through to the retry prompt
            fi
        fi
    fi

    # 6. Prompt the user to try again
    while true; do
        read -r -p "Do you wanna try again? (y/n): " RETRY_CHOICE < /dev/tty
        RETRY_CHOICE=$(echo "$RETRY_CHOICE" | tr '[:upper:]' '[:lower:]')

        if [[ "$RETRY_CHOICE" == "n" ]]; then
            echo "Exiting."
            exit 1
        elif [[ "$RETRY_CHOICE" == "y" ]]; then
            # Break the inner loop, which continues the main validation loop (while true)
            break
        else
            echo "Invalid input. Please enter 'y' or 'n'."
        fi
    done
done
